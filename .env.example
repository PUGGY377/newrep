# Copy this file to .env and fill in real values. Never commit .env.
#
# Kalshi API credentials. Kalshi uses RSA-key-pair auth: you generate a
# keypair, upload the PUBLIC key in the Kalshi UI, and sign requests with
# the PRIVATE key. Never paste the private key contents directly into
# this file in a shared/committed context -- point at a local file path
# that is itself gitignored, or a secrets manager in production.
KALSHI_API_KEY_ID=
# Provide the private key ONE of two ways:
#   - a file path (local machine):
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
#   - or the PEM text itself (cloud environment variable; "\n" escapes are OK):
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# "demo" uses Kalshi's demo/sandbox environment, "prod" is the real
# exchange. The system defaults to demo everywhere unless explicitly
# overridden, and live order submission additionally requires
# execution.mode=live in config/*.yaml AND this env var set to prod.
KALSHI_ENVIRONMENT=demo

# Optional external data source keys (sports category)
ODDS_API_KEY=

# Set to "true" only when you intend to place real orders with real money.
# This is a second, independent gate on top of config execution.mode=live --
# both must agree before any live order is submitted.
KALSHI_LIVE_TRADING_CONFIRMED=false
